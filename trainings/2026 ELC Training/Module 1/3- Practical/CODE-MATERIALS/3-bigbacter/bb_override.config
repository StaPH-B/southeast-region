process {
  // Remove -e just for GUBBINS so the ulimit failure won't abort the script
  withName: /.*CORE:GUBBINS.*/ {
    shell = ['/bin/bash','-uo','pipefail']   // drop -e
  }

  // If the pipeline added that ulimit via beforeScript, nuke it:
  withName: /.*CORE:GUBBINS.*/ {
    beforeScript = ''
  }
}
